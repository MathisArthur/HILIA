{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/og.js": {
      "includeFiles": [
        "node_modules/satori/yoga.wasm",
        "node_modules/harfbuzzjs/hb.wasm",
        "node_modules/harfbuzzjs/hb-subset.wasm",
        "node_modules/@resvg/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/lieu/:slug", "destination": "/api/place?slug=:slug" },
    { "source": "/a-propos", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/prestataires", "destination": "/index.html" },
    { "source": "/mon-profil", "destination": "/index.html" },
    { "source": "/mentions-legales", "destination": "/index.html" },
    { "source": "/confidentialite", "destination": "/index.html" },
    { "source": "/cgu", "destination": "/index.html" },
    { "source": "/cookies", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/accessibilite", "destination": "/index.html" },
    { "source": "/plan-du-site", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://unpkg.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://cdnjs.cloudflare.com https://unpkg.com; connect-src 'self' https://lokplzdkvzilsuuqflsk.supabase.co wss://lokplzdkvzilsuuqflsk.supabase.co https://tiles.openfreemap.org https://api-adresse.data.gouv.fr; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|ico|svg|webp|jpg|jpeg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
